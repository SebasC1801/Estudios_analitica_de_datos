import kagglehub
import os
import shutil

# ============================================================
# CONFIGURACIÓN
# ============================================================

DATASET = "akhil06022004/ufo-sightings-scrubbed"

# Carpeta donde queremos guardar el CSV
DESTINO = os.path.join(
    os.path.dirname(os.path.abspath(__file__)),
    "dataset"
)

os.makedirs(DESTINO, exist_ok=True)


# ============================================================
# DESCARGAR DATASET DESDE KAGGLE
# ============================================================

print("Descargando dataset desde Kaggle...")
print(f"Dataset: {DATASET}")

path = kagglehub.dataset_download(DATASET)

print("\nDataset descargado correctamente.")
print("Ubicación temporal de KaggleHub:")
print(path)


# ============================================================
# BUSCAR ARCHIVOS CSV
# ============================================================

print("\nBuscando archivos CSV...")

csv_encontrados = []

for root, dirs, files in os.walk(path):

    for file in files:

        if file.lower().endswith(".csv"):

            ruta = os.path.join(root, file)

            csv_encontrados.append(ruta)


# ============================================================
# COPIAR CSV
# ============================================================

if not csv_encontrados:

    print("\nNo se encontraron archivos CSV.")

else:

    print(f"\nSe encontraron {len(csv_encontrados)} archivo(s) CSV:")

    for csv in csv_encontrados:
        print("-", csv)


    for csv in csv_encontrados:

        nombre = os.path.basename(csv)

        destino_csv = os.path.join(
            DESTINO,
            nombre
        )

        shutil.copy2(
            csv,
            destino_csv
        )

        print("\nCSV copiado:")
        print(destino_csv)


# ============================================================
# RESULTADO
# ============================================================

print("\n" + "=" * 60)
print("PROCESO COMPLETADO")
print("=" * 60)

print("Carpeta de destino:")
print(DESTINO)

print("\nContenido:")

for archivo in os.listdir(DESTINO):
    print("-", archivo)